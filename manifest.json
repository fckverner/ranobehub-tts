{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ranobehub.org/*",
        "https://*.ranobehub.org/*"
      ],
      "js": [
        "lib/settings.js",
        "lib/manifest-matcher.js",
        "lib/chapter-meta.js",
        "content/templates.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.css",
        "icons/icon48.png"
      ],
      "matches": [
        "https://ranobehub.org/*",
        "https://*.ranobehub.org/*"
      ]
    }
  ],
  "host_permissions": [
    "https://ranobehub.org/*",
    "https://*.ranobehub.org/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs-us-1.hf.co/*",
    "https://cas-bridge.xethub.hf.co/*",
    "https://transfer.xethub.hf.co/*"
  ]
}
